## Copy to .env, replace every value, and keep that file out of Git.
## Docker Compose service DNS uses the MySQL service name, not "wordpress".
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=replace-with-a-long-random-wordpress-password

WORDPRESS_DB_HOST=mysql:3306
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=replace-with-a-long-random-wordpress-password

# phpMyAdmin connects to the internal Compose DNS name. It does not receive
# database credentials; authenticate in its UI with a MySQL account instead.
PMA_HOST=mysql
PMA_PORT=3306

# Used only by Nginx to protect /admin/ and /grafana/. Generate a unique value.
ADMIN_BASIC_AUTH_USER=cloud1-admin
ADMIN_BASIC_AUTH_PASSWORD=replace-with-a-long-random-admin-password

# Used only on Grafana's first initialization. Changes after its data volume is
# initialized do not rotate the existing Grafana administrator.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-grafana-password
# Public DNS name or public IP used to reach this Nginx host (no scheme/path).
GRAFANA_DOMAIN=your-server.example.com
